<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test program: runs the uploader against a fake FTP server. dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>TestHarness</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" Link="App\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
